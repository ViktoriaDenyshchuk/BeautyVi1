<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Чат з AI</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }

        #chatBox {
            width: 400px;
            height: 300px;
            border: 1px solid #ccc;
            padding: 10px;
            overflow-y: scroll;
            margin-bottom: 10px;
        }

        #userInput {
            width: 300px;
            padding: 5px;
        }

        button {
            padding: 5px 10px;
        }
    </style>
</head>
<body>
    <h1>Чат з AI</h1>
    <div id="chatBox"></div>
    <input type="text" id="userInput" placeholder="Введіть ваше повідомлення...">
    <button onclick="sendMessage()">Надіслати</button>

    <script>async function sendMessage() {
            const userInput = document.getElementById("userInput").value;
            if (!userInput) return;

            // Додаємо повідомлення користувача в чат
            const chatBox = document.getElementById("chatBox");
            chatBox.innerHTML += `<div><strong>Ви:</strong> ${userInput}</div>`;

            // Відправляємо повідомлення на сервер
            const response = await fetch("/api/ai/chat", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(userInput)
            });

            const result = await response.text();

            // Додаємо відповідь AI в чат
            chatBox.innerHTML += `<div><strong>AI:</strong> ${result}</div>`;

            // Очищуємо поле введення
            document.getElementById("userInput").value = "";

            // Прокручуємо чат донизу
            chatBox.scrollTop = chatBox.scrollHeight;
        }</script>
</body>
</html>